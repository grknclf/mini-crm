{
  "name": "mini-crm",
  "version": "0.1.0",
  "description": "Mini-CRM projesi. Müşteri ve sipariş yönetimi senaryosu üzerinden logging, test ve ETL süreçlerini göstermek amacıyla geliştirilmiştir.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "migrate": "sequelize db:migrate",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.0",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.7.4",
    "sequelize-cli": "^6.6.5",
    "supertest": "^6.3.4"
  }
}
