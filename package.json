{
  "name": "mini-crm",
  "version": "0.1.0",
  "description": "Mini-CRM projesi. Müşteri ve sipariş yönetimi senaryosu üzerinden logging, test ve ETL süreçlerini göstermek amacıyla geliştirilmiştir.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "migrate": "sequelize db:migrate"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.0",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.5",
    "supertest": "^6.3.4"
  }
}
